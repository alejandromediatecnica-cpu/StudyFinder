# Plantilla de configuración del frontend de StudyFinder.
# Copia este archivo como `.env` y ajusta los valores. `.env` NO se sube a Git.
# Las variables definidas en el sistema (p. ej. en el panel de Vercel) tienen prioridad
# sobre las de este archivo.

# =====================================================================
# Compilación: se incrustan en el JavaScript que descarga el navegador,
# así que son PÚBLICAS. Nunca pongas aquí contraseñas, tokens ni claves.
# `npm start`, `npm run build`, `npm run watch` y `npm test` ejecutan antes
# `scripts/generate-env.mjs`, que genera `src/environments/environment.ts`.
# Tras cambiar un valor, reinicia `npm start`.
# =====================================================================

# URL base de la API del backend (FastAPI), sin barra final.
# El origen del frontend debe estar incluido en CORS_ORIGINS del backend.
# Por defecto: http://localhost:8000
API_URL=http://localhost:8000

# =====================================================================
# Ejecución del servidor SSR (`npm run serve:ssr:studyfinderFront`).
# Las lee `src/server.ts` al arrancar; no llegan al navegador.
# =====================================================================

# Hosts (sin protocolo ni puerto) a los que el servidor SSR acepta responder, separados
# por comas. Protege contra SSRF: una petición con otra cabecera Host recibe 400.
# Admite comodines de subdominio (*.midominio.com). En producción pon el dominio real.
# Es la variable nativa de Angular SSR. OBLIGATORIA: sin ella, todo host recibe 400.
NG_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1]

# Puerto en el que escucha el servidor SSR. Por defecto: 4000
PORT=4000
