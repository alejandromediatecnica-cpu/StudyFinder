# ============================================================
# StudyFinder - Backend - Variables de entorno
# ------------------------------------------------------------
# Copia este archivo a ".env" y rellena los valores reales:
#   Copy-Item .env.example .env      (Windows / PowerShell)
#   cp .env.example .env             (macOS / Linux)
#
# En Render define estas MISMAS variables en el panel del
# servicio: Environment -> Environment Variables.
# El archivo ".env" está en .gitignore: nunca se sube a Git.
# ============================================================

# Cadena de conexión de MongoDB (Atlas o local). NO la publiques.
MONGODB_URL=mongodb+srv://<db_username>:<db_password>@studenthub1.ubui5i2.mongodb.net/?appName=StudentHub1

# Nombre de la base de datos.
MONGODB_DATABASE=studyfinder

# Orígenes permitidos por CORS, separados por coma.
# En desarrollo deja los locales.
# En producción pon la URL pública del frontend, por ejemplo:
#   CORS_ORIGINS=https://studyfinder-front.onrender.com
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Puerto del servidor. En Render se asigna solo; en local usa 8000.
PORT=8000
